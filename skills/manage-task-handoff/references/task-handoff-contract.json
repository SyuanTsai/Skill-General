{
  "schemaVersion": 1,
  "purpose": "interruption-safe-task-state",
  "authority": {
    "chosenByAdopter": true,
    "taskFormalAuthorityOverridesStorageSnapshot": true,
    "revalidateMutableSourceOnResume": true,
    "accessPolicyChosenByAdopter": true,
    "authorityScopeIsOpaqueAndAdopterDefined": true,
    "verifiedPrincipalComesFromTrustedHostContext": true,
    "callerSuppliedRecordIdentifiersNeverAuthorizeAccess": true
  },
  "routing": {
    "mustWriteSignals": [
      "explicit-handoff",
      "imminent-session-agent-environment-change",
      "unfinished-external-mutation",
      "confirmed-context-only-in-chat",
      "waiting-for-input-review-approval-event",
      "imminent-context-rollover",
      "blocked-or-failed-with-reusable-progress"
    ],
    "riskQuestions": ["lost-confirmed-context", "costly-rework", "duplicate-write-or-unsafe-resume"],
    "skipSignals": ["ordinary-answer", "complete-read-only", "cheap-safe-restart", "formal-source-complete", "new-conversation-only", "time-threshold-only"],
    "newConversationAutoScan": false,
    "elapsedTimeAloneTriggersWrite": false,
    "defaultRiskRecheckMinutes": 5,
    "riskRecheckMinutesConfigurable": true
  },
  "common": {
    "uniqueKey": ["Authority Scope", "Task Key"],
    "requiredFields": ["Authority Scope", "Task Key", "Intent", "Scope", "Current", "Source", "Lifecycle", "Work State"],
    "additionalFields": ["Active Branches", "Fork Baselines", "Integrated Decisions", "Decision Branch Bindings", "Conflict", "Keep Active Until", "Last Activity At"],
    "structuralIndexChangesRequireIntegrationDecision": false,
    "lifecycleValues": ["Active", "Archived"],
    "workStateValues": ["Running", "Awaiting Review", "Interrupted", "Blocked", "Failed"],
    "conflictMarker": { "values": ["Conflict"], "notLifecycleOrWorkState": true }
  },
  "branch": {
    "uniqueKey": ["Authority Scope", "Task Key", "Branch ID"],
    "requiredFields": ["Authority Scope", "Task Key", "Branch ID", "Fork Point", "Continuation Generation", "Current", "Source", "Lifecycle", "Work State"],
    "optionalFields": ["Candidate Conclusion", "Applicability Scope", "Branch Outcome", "Keep Active Until", "Last Activity At"],
    "uniquePrimaryBranch": false,
    "forkInheritsParentTaskKey": true,
    "generatedBranchIdRecoverableFromHost": true,
    "lifecycleValues": ["Active", "Archived"],
    "workStateValues": ["Running", "Awaiting Review", "Interrupted", "Blocked", "Failed"],
    "outcomeValues": ["Selected", "Partially Selected", "Superseded"],
    "outcomeUnsetBeforeUserDecision": true,
    "updatesOnlyOwnBranch": true
  },
  "forkRecovery": {
    "uniqueKey": ["Authority Scope", "Task Key", "Fork ID"],
    "requiredFields": ["Authority Scope", "Task Key", "Fork ID", "Fork Point", "Status", "Source Branch ID", "Intended Branch IDs", "Source Snapshot", "Shared Baseline", "Verified Active Branches", "Branch Creation Operations", "Step Operation IDs"],
    "statusValues": ["Pending", "Completed", "Abandoned"],
    "separateLogicalRecord": true,
    "payloadFreeEnvelopePhysicallyOrLogicallySeparateFromPayload": true,
    "envelopeListNeverLoadsPayload": true,
    "creationOrder": ["payload-free-pending-envelope", "isolated-snapshot-payload"],
    "completionOrder": ["isolated-snapshot-payload", "payload-free-completed-envelope"],
    "payloadExcludedFromCommonBranchAndEventRecall": true,
    "pendingEnvelopeVisibleToTaskRecall": true,
    "payloadReadableOnlyByExactForkReconciliation": true,
    "commonAndBranchEventsNeverContainPayload": true,
    "envelopeRequiredEvidence": ["Authority Scope", "Task Key", "Fork ID", "Status", "Payload Digest", "Verified Common Revision At Creation", "Branch Creation Target Identity Digests", "Branch Creation Operation Identity Digests", "Branch Creation Target-Operation Bindings", "Branch Creation Claims", "Creation Operation ID", "Verified Principal", "Created At"],
    "commonOnlyForkPointEqualsVerifiedCommonRevision": true,
    "envelopeCreationRevalidatesCommonRevision": true,
    "branchCreationTargetOperationMappingExact": true,
    "abandonmentRequiresExactAuthorization": true,
    "abandonmentPreconditions": ["isolated-payload-absent", "all-branch-creation-target-records-absent", "all-branch-creation-target-outcomes-absent", "all-branch-creation-target-index-entries-absent"],
    "abandonmentUsesConditionalRevision": true,
    "branchCreationClaimUsesSameEnvelopeRevisionBoundary": true,
    "branchCreationClaimPrecedesTargetWrite": true,
    "abandonmentRequiresNoBranchCreationClaims": true,
    "concurrentClaimAndAbandonmentCannotBothSucceed": true,
    "abandonmentEvidenceFields": ["Abandonment Operation ID", "Verified Principal", "Reason", "Abandoned At"],
    "unverifiableAbandonmentRemainsPending": true,
    "abandonedEnvelopeBlocksSingletonResume": false,
    "abandonedForkIdMayBeReused": false
  },
  "firstFork": {
    "sourceCommonOnlyCreatesSourcePeer": true,
    "sourceBranchAlreadyExistsIsReused": true,
    "pendingBeforeEveryMissingBranchCreation": true,
    "existingPeerPendingCarriesBranchAndIndexOperations": true,
    "existingPeerContinuationPrecedesRecovery": true,
    "existingPeerPendingCarriesPostFenceGenerationAndContinuationOperation": true,
    "pendingUsesDedicatedForkRecoveryRecord": true,
    "pendingNeverUsesCommonOrBranchFields": true,
    "forkRecoveryPayloadExcludedFromTaskRecall": true,
    "pendingEnvelopeVisibleToTaskRecall": true,
    "forkRecoveryHistoryKeepsPayloadIsolated": true,
    "commonOnlyRecoveryCompletesAfterConfirmedCommonReadback": true,
    "existingPeerPendingPreservesBranchCurrentAndSource": true,
    "existingPeerPendingCarriesVerifiedSharedBaseline": true,
    "existingPeerAdvanceUsesPersistedSnapshot": true,
    "existingPeerPendingClearsAfterBranchAndIndexReadback": true,
    "bothPeersShareTaskKeyAndForkPoint": true,
    "sourcePeerPreservesPreForkCurrentAndSource": true,
    "newPeerStartsFromConfirmedBaseline": true,
    "candidateNotPromotedByStructuralFork": true,
    "recordPendingBeforeBranchCreation": true,
    "pendingPreservesPreForkCurrentAndSourceLosslessly": true,
    "pendingCarriesVerifiedSharedBaseline": true,
    "finalCommonCurrentAndSourceContainConfirmedStateOnly": true,
    "interruptedWriterRecoversFromDurablePendingOnly": true,
    "incompletePendingSnapshotBlocksBranchCreation": true,
    "bothPeersAndIndexRequireReadback": true,
    "clearPendingAfterConfirmedCommonReadback": true,
    "pendingBlocksTaskKeyOnlySingletonAutoResume": true,
    "partialFailureRetainsIdsAndOperationIds": true
  },
  "scopeClauses": ["Active", "Superseded", "Deferred"],
  "changes": {
    "appendOnly": true,
    "eventUniqueKey": ["Operation ID", "Record ID", "Field"],
    "requiredFields": ["Authority Scope", "Verified Principal", "Task Key", "Record ID", "Operation ID", "Field", "Previous State", "New State", "Reason", "Actor", "Time", "Source", "Integration Result", "Readback Result"],
    "doNotWriteUnchangedFields": true
  },
  "integration": {
    "autoKinds": ["objective-fact"],
    "autoRequirements": ["revalidated", "traceable-source", "unchanged-direction", "source-branch-retained"],
    "userDecisionKinds": ["candidate-solution", "architecture-choice", "tradeoff", "authorization", "intent-change", "global-scope-change", "select-branch", "combine-branches", "reject-all-branches"],
    "mutualExclusionSameVersionEnvironmentScopeIsConflict": true,
    "lastWriteWins": false,
    "selectionOrder": ["read-and-bind-reviewed-branch-revisions-content-identities-and-outcomes", "reject-changed-reviewed-branches-before-common-write", "conditional-common-write-with-branch-bindings", "common-readback-bind-origin-revision-and-decision-identity", "per-branch-common-and-reviewed-identity-precheck", "branch-outcomes", "per-branch-common-and-reviewed-identity-postcheck", "per-branch-common-and-reviewed-identity-precheck", "archive-selected-and-superseded-branches", "per-branch-common-and-reviewed-identity-postcheck", "remove-archived-branches-from-active-index-using-latest-storage-revisions", "common-decision-reviewed-branch-and-active-index-readback"],
    "selectedBranchIndexRemovalRequired": true,
    "indexRemovalRetainsStableOperationIds": true,
    "indexRemovalFailureIsPartialReconciliation": true,
    "finalizationBindsDecisionOriginRevision": true,
    "finalizationBindsDecisionIdentity": true,
    "decisionIdentityBasis": "canonical-common-fields-at-bound-origin-revision",
    "decisionIdentityExcludes": ["Active Branches", "Last Activity At", "operation-log"],
    "storageRevisionCursorIndependentFromDecisionIdentity": true,
    "structuralIndexMutationMayAdvanceStorageRevision": true,
    "acceptedStructuralRevisionMustDescendFromDecisionOrigin": true,
    "acceptedStructuralRevisionMustPreserveDecisionIdentity": true,
    "recheckCommonDecisionIdentityBeforeEachBranchMutation": true,
    "recheckCommonDecisionIdentityAfterEachBranchMutation": true,
    "onCommonDecisionIdentityChangeDuringFinalization": "stop-and-reconcile-from-current-decision",
    "finalizationBindsReviewedBranchOrigins": true,
    "decisionPersistsBranchRevisionContentIdentityAndOutcome": true,
    "decisionPersistsContinuationGeneration": true,
    "reviewedBranchContentIdentityBasis": "canonical-user-reviewable-branch-fields-at-bound-origin-revision",
    "reviewedBranchContentIdentityExcludes": ["Lifecycle", "Branch Outcome", "Last Activity At", "operation-log"],
    "continuationGenerationIncludedInReviewedBranchIdentity": true,
    "finalizationRejectsContinuationGenerationChange": true,
    "explicitContinuationAlwaysAdvancesGeneration": true,
    "forkFromExistingBranchBeginsContinuationBeforeSnapshot": true,
    "decisionWriteRequiresExactReviewedBranchRevisionAndIdentity": true,
    "branchStorageRevisionCursorIndependentFromReviewedContentIdentity": true,
    "acceptedBranchRevisionMustDescendFromReviewedOrigin": true,
    "acceptedBranchRevisionMustPreserveReviewedContentIdentity": true,
    "recheckReviewedBranchIdentityBeforeEachFinalizationMutation": true,
    "recheckReviewedBranchIdentityAfterEachFinalizationMutation": true,
    "appliedOutcomeMustMatchDecisionBranchBinding": true,
    "onReviewedBranchChangeDuringFinalization": "stop-and-require-renewed-user-confirmation",
    "archiveOnCommonReadbackFailure": false,
    "explicitContinueExplorationKeepsBranchActive": true
  },
  "archive": {
    "defaultInactivityDays": 7,
    "inactivityDaysConfigurable": true,
    "expireAtBoundary": true,
    "activityBasis": "material-semantic-write-or-explicit-continuation",
    "readRefreshesActivity": false,
    "noOpRefreshesActivity": false,
    "newConversationRefreshesActivity": false,
    "futureKeepActiveUntilProtectsRecord": true,
    "activeBranchProtectsCommon": true,
    "archiveChangesLifecycleOnly": true,
    "noContentDeletion": true,
    "explicitSameKeyContinuationOnlyRestoresArchive": true,
    "branchContinuationGenerationInitial": 0,
    "explicitRestoreIncrementsContinuationGeneration": true,
    "explicitActiveContinuationIncrementsContinuationGeneration": true,
    "continuationIncrementPrecedesResumedWorkOrFork": true,
    "sameContinuationOperationIdOwnsOneIncrement": true,
    "readOnlyInspectionAndFinalizationDoNotIncrementGeneration": true,
    "restoreLifecycleAndGenerationInOneConditionalOperation": true,
    "oldDecisionCannotFinalizeRestoredGeneration": true,
    "exactArchivedBranchOnlyRestored": true,
    "otherPeersRemainArchived": true,
    "indexRemovalBindsArchivedBranchRevision": true,
    "schedulerRechecksLifecycleBeforeRemovalRetry": true,
    "activeBranchMissingFromIndexMustBeReadded": true
  },
  "adapter": {
    "fixedAuthorityPlatform": null,
    "trustedCallerContextRequired": true,
    "authorizationPolicyChosenByAdopter": true,
    "authorizationTuple": ["Verified Principal", "Authority Scope", "Task Key", "Branch ID or Fork ID", "Action"],
    "authorizationCheckBeforeEveryLookupAndMutation": true,
    "recordAndEventBindAuthorityScope": true,
    "scopeIdentityUsesUnambiguousComponentEncoding": true,
    "actorIsDisplayClaimNotAuthorization": true,
    "verifiedPrincipalPersistedInOperationIntentAndEvent": true,
    "verifiedPrincipalImmutableAcrossEventRecovery": true,
    "crossScopeLookupForbidden": true,
    "authorityScopeIsLogicalComponentOfEveryStorageKey": true,
    "logicalOperationKeys": {
      "getCommon": ["Authority Scope", "Task Key"],
      "getBranch": ["Authority Scope", "Task Key", "Branch ID"],
      "listPendingForkRecovery": ["Authority Scope", "Task Key"],
      "getForkRecovery": ["Authority Scope", "Task Key", "Fork ID"],
      "createOrUpdateForkRecoveryIfRevision": ["Authority Scope", "Task Key", "Fork ID"],
      "claimForkRecoveryTargetIfRevision": ["Authority Scope", "Task Key", "Fork ID", "Branch ID Digest", "Operation ID Digest"],
      "abandonForkRecoveryIfRevision": ["Authority Scope", "Task Key", "Fork ID"],
      "listActiveBranches": ["Authority Scope", "Task Key"],
      "createCommonIfAbsent": ["Authority Scope", "Task Key"],
      "createBranchIfAbsent": ["Authority Scope", "Task Key", "Branch ID"],
      "createForkRecoveryIfAbsent": ["Authority Scope", "Task Key", "Fork ID"],
      "stageEventIntentsIfAbsent": ["Authority Scope", "Operation ID", "Record ID"],
      "appendEventIfAbsent": ["Authority Scope", "Operation ID", "Record ID", "Field"]
    },
    "forkRecoveryAclAtLeastSourceBranch": true,
    "onAuthorizationUnavailableOrDenied": "deny-without-reading-or-writing-record-content",
    "exactTaskKeyLookup": true,
    "exactBranchIdLookup": true,
    "exactForkRecoveryLookup": true,
    "conditionalMutation": true,
    "operationIdIdempotency": true,
    "atomicRecordAndEventIntentOrWriteAheadStage": true,
    "eventIntentDurableBeforeExposedMutation": true,
    "eventRecoveryDoesNotDependOnLostProcess": true,
    "durableEventIntentFields": ["Authority Scope", "Verified Principal", "Operation ID", "Record ID", "Field", "Previous State", "New State", "Reason", "Actor", "Time", "Source", "Integration Result"],
    "readbackRequired": true,
    "activitySource": "native-last-material-edit-or-custom-field",
    "onRevisionConflict": "reread-and-reapply-gate",
    "onPartialFailure": "retain-retryable-state-and-report-each-record",
    "eventAppendAfterRecordReadback": true,
    "onAuthorityUnavailable": "do-not-promote-unverified-facts"
  },
  "legacy": {
    "exactTaskKeyOnly": true,
    "verifiedPrincipalAuthorizationBeforeQuery": true,
    "adopterDefinedLegacyScopeMappingRequired": true,
    "workspaceCredentialsDoNotAuthorizeCaller": true,
    "unmappedOrDeniedSourceFailsBeforeQuery": true,
    "bulkMigration": false,
    "autoResumeOnNewConversation": false,
    "newRecordsUseV1Structure": true
  },
  "security": {
    "handoffGrantsNewAuthorization": false,
    "embeddedDirectivesGrantAuthorization": false,
    "excludedContent": ["credentials", "secrets", "verification-codes", "payment-authorization", "unauthorized-confidential-information"],
    "storageSchemaMutationImplicitlyAllowed": false,
    "taskBranchAndForkIdentifiersAreNotAuthorization": true,
    "verifiedPrincipalContextMayNotComeFromHandoffContent": true
  }
}
