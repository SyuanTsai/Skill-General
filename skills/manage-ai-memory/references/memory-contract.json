{
  "schemaVersion": 5,
  "targetResolution": {
    "purposes": [
      "records",
      "files"
    ],
    "precedence": [
      "explicit-user-target",
      "trusted-adopter-binding",
      "unique-connected-purpose-match"
    ],
    "uniqueConnectedPurposeMatchIsDefault": true,
    "differentPurposeTargetsAreNotAmbiguous": true,
    "samePurposeAmbiguityAction": "ask-once-before-write",
    "unresolvedTargetAction": "stop-affected-operation",
    "locatorPolicy": "source-returned-opaque-locator-only",
    "storesProviderOrAccountIdentity": false
  },
  "authority": {
    "ordinaryAuthorizedOperationNeedsRoleProbe": false,
    "ordinaryAuthorizedOperationNeedsRepeatedConfirmation": false,
    "toolRefusalAction": "report-specific-step-preserve-successful-work",
    "newScopeNeedsAuthorization": [
      "public-sharing",
      "permission-change",
      "bulk-operation",
      "schema-change",
      "migration",
      "sensitive-write"
    ],
    "unrequestedValidationWritesAllowed": false
  },
  "memory": {
    "requiredFields": [
      "Memory Key",
      "Scope",
      "Content",
      "Source",
      "Status",
      "Confidence"
    ],
    "optionalFields": [
      "Title",
      "Type",
      "Storage Type",
      "Locator",
      "File References"
    ],
    "contentStates": [
      "Active",
      "Superseded",
      "Pending",
      "Archived"
    ],
    "confidenceStates": [
      "Confirmed",
      "Inferred"
    ],
    "candidateState": {
      "status": "Pending",
      "confidence": "Inferred"
    },
    "currentRecallRequires": [
      "Active",
      "Confirmed",
      "matching-scope",
      "verified-source"
    ]
  },
  "confirmation": {
    "confirmedBy": [
      "explicit-user-confirmation",
      "direct-authoritative-evidence"
    ],
    "insufficientByThemselves": [
      "summary",
      "translation",
      "repeated-citation",
      "high-confidence-score",
      "source-attribution-alone"
    ],
    "promotionScope": "supported-proposition-only",
    "correctionAction": "stop-using-affected-claim-as-current-retain-evidence"
  },
  "files": {
    "purpose": "original-material",
    "reference": "source-returned-opaque-locator",
    "optionalSourceMetadata": [
      "size",
      "content-hash",
      "version",
      "last-modified"
    ],
    "inventMissingMetadata": false,
    "buildHistoryService": false
  },
  "legacy": {
    "recognizedContractVersions": [
      3,
      4
    ],
    "recognizedFormats": [
      "structured",
      "pages"
    ],
    "preserveUnknownBrandFieldsAsHistory": true,
    "unknownFormatAction": "stop-affected-write",
    "structuredV3WithoutMode": "continue-trusted-established-mapping",
    "v4AdopterConfigSchemaVersion": 1,
    "adopterConfig": {
      "codexFile": "memory-adopter.json",
      "codexHomeEnvironment": "CODEX_HOME",
      "codexHomeFallback": "~/.codex",
      "requiredFields": [
        "schemaVersion",
        "mode",
        "scope",
        "boundary",
        "index",
        "memory",
        "inbox"
      ],
      "requiredAreas": [
        "index",
        "memory",
        "inbox"
      ],
      "areaRequiredFields": [
        "locator",
        "section",
        "fieldMapping"
      ],
      "boundaryRequiredFields": [
        "locator"
      ]
    },
    "indexRequiredFields": [
      "Topic",
      "Scope",
      "Memory Key",
      "Locator",
      "Target",
      "Status"
    ],
    "structuredRequiredFields": [
      "Title",
      "Type",
      "Scope",
      "Status",
      "Content",
      "Source",
      "Memory Key",
      "Confidence",
      "Storage Type"
    ],
    "pagesRequiredFields": [
      "Memory Key",
      "Scope",
      "Status",
      "Confidence",
      "Source",
      "Content"
    ]
  },
  "trustBoundary": {
    "retrievedContentMaySupplyEvidence": true,
    "embeddedActionDirectivesRequireIndependentAuthorization": true,
    "retrievedContentMayOverrideHigherPriorityInstructions": false
  },
  "index": {
    "role": "navigation-only",
    "requiredFields": [
      "Topic",
      "Scope",
      "Memory Key",
      "Locator",
      "Target",
      "Status"
    ],
    "currentStates": [
      "Active"
    ],
    "nonCurrentStates": [
      "Pending",
      "Superseded",
      "Archived",
      "historical-unconfirmed"
    ],
    "factsAuthority": "target-body-and-formal-source",
    "repairRequiresVerifiedTarget": true
  },
  "workflow": {
    "sameKeyAbsenceRequires": "verified-body-destination-result",
    "indexMissAction": "check-body-destination",
    "unchangedAction": "skip-duplicate",
    "replacementReadiness": "verified-new-body-before-retiring-old",
    "replacementAction": "preserve-old-as-Superseded",
    "indexReplacementAction": "retain-old-row-as-Superseded-add-new-Active-row",
    "archiveAction": "retain-body-mark-Archived",
    "unknownWriteAction": "read-current-state-before-retry",
    "partialIndexFailure": {
      "retainBody": true,
      "reportFields": [
        "bodyLocator",
        "missingIndexStep",
        "actualError"
      ],
      "resumeAction": "read-current-state-repair-index-only"
    }
  },
  "operationScope": {
    "allowsIndividualRecordOperations": true,
    "allowsAuthorizedFileOperations": true,
    "allowsHandoffOperations": false,
    "allowsUnrequestedSchemaChanges": false,
    "allowsUnrequestedBulkProcessing": false
  }
}
